# neon deploy pulls the first five values into ignored .env.local.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full
NEON_BRANCH=production
NEON_AUTH_BASE_URL=https://YOUR-HOST/neondb/auth
NEON_AUTH_JWKS_URL=https://YOUR-HOST/neondb/auth/.well-known/jwks.json
# Public API origin; this is safe to include in the static client configuration.
NEON_API_URL=http://127.0.0.1:8787/
# Instagram server-only configuration. Keep delivery disabled until Meta acceptance tests pass.
INSTAGRAM_ENABLED=false
INSTAGRAM_ADMIN_IDS=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_GRAPH_VERSION=

# Public Meta developer app identifier (not the Instagram account ID).
INSTAGRAM_APP_ID=
