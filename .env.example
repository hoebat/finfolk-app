# neon deploy pulls the first five values into ignored .env.local.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full
NEON_BRANCH=production
NEON_AUTH_BASE_URL=https://YOUR-HOST/neondb/auth
NEON_AUTH_JWKS_URL=https://YOUR-HOST/neondb/auth/.well-known/jwks.json
# Public API origin; this is safe to include in the static client configuration.
NEON_API_URL=http://127.0.0.1:8787/
# Instagram server-only configuration. Keep delivery disabled until Meta acceptance tests pass.
INSTAGRAM_ENABLED=false
INSTAGRAM_ADMIN_IDS=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_GRAPH_VERSION=

# Public Meta developer app identifier (not the Instagram account ID).
INSTAGRAM_APP_ID=

# Facebook Login for Business configuration identifier.
INSTAGRAM_LOGIN_CONFIG_ID=

# Linked brand Facebook Page identifier (not the Instagram account ID).
INSTAGRAM_FACEBOOK_PAGE_ID=

# Separate server-side rollout gates; leave off until real-provider tests pass.
INSTAGRAM_DISCOVERY_ENABLED=false
INSTAGRAM_PUBLICATION_ENABLED=false
INSTAGRAM_HASHTAGS_ENABLED=false
# Manual beach-post review; separate from Instagram automation.
COMMUNITY_POSTS_ENABLED=false
COMMUNITY_PILOT_BEACHES=
# Reuse the server-only INSTAGRAM_ADMIN_IDS list for review access.

# Enable only after real message identity, follow checks and replies pass acceptance.
INSTAGRAM_DM_ENABLED=false
INSTAGRAM_AUTO_CLAIM_ENABLED=false

# Versioned messaging; separate from the existing Page-token discovery integration.
# New Meta apps use instagram-unified; older apps can retain instagram-login.
INSTAGRAM_MESSAGING_PROVIDER=instagram-facebook
# Facebook Page mode: pin the Page linked to the configured Instagram account.
INSTAGRAM_MESSAGING_PAGE_ID=
# Unified Login uses a compatible business-integration system-user configuration.
INSTAGRAM_MESSAGING_LOGIN_CONFIG_ID=
# Meta App Basic secret, never the Instagram product secret. Defaults to INSTAGRAM_APP_SECRET
# only when the Meta app IDs match. Server-only.
INSTAGRAM_MESSAGING_META_APP_SECRET=
# Client ID/secret come from the Instagram Login product, not the Meta App Basic pair.
INSTAGRAM_MESSAGING_APP_ID=
INSTAGRAM_MESSAGING_CLIENT_SECRET=
# Meta app ID/secret used to verify webhook delivery and account subscriptions.
INSTAGRAM_MESSAGING_META_APP_ID=
INSTAGRAM_MESSAGING_WEBHOOK_SECRET=
# Optional expected Instagram Login brand ID, verified during OAuth.
INSTAGRAM_MESSAGING_ACCOUNT_ID=
INSTAGRAM_MESSAGING_GRAPH_VERSION=v26.0
INSTAGRAM_MESSAGING_REDIRECT_URI=https://api.finfolk.com.au/v1/integrations/instagram/oauth/callback
# Base64-encoded 32-byte AES key; server-only. Back it up before using it.
MESSAGING_ENCRYPTION_KEY=
