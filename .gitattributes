# Source survey files belong in Git LFS. Pages publishes materialized build outputs.
# Keep the consolidated Atelier's source raster artwork portable in LFS.
design-board/assets/**/*.png filter=lfs diff=lfs merge=lfs -text
design-board/assets/**/*.jpg filter=lfs diff=lfs merge=lfs -text
design-board/assets/**/*.webp filter=lfs diff=lfs merge=lfs -text
* text=auto
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.las filter=lfs diff=lfs merge=lfs -text
*.laz filter=lfs diff=lfs merge=lfs -text
*.asc filter=lfs diff=lfs merge=lfs -text
*.f32 filter=lfs diff=lfs merge=lfs -text
*.gz filter=lfs diff=lfs merge=lfs -text
*.nc filter=lfs diff=lfs merge=lfs -text
*.grd filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
datasets/raw/**/original.geojson filter=lfs diff=lfs merge=lfs -text
datasets/processed/**/*.geojson filter=lfs diff=lfs merge=lfs -text

# Dataset catalogue snapshots and derived geometry remain authoritative in LFS.
design-board/assets/datasets/**/*.json filter=lfs diff=lfs merge=lfs -text
design-board/assets/datasets/*.json filter=lfs diff=lfs merge=lfs -text
design-board/assets/bondi-surveys/*.geojson filter=lfs diff=lfs merge=lfs -text
