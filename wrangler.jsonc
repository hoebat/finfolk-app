{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finfolk-community",
  "main": "backend/worker.mjs",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "account_id": "b048221dbe18365ea667373f6fda1f73",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "648980b6138d404ca072d9af7b3f31e3"
    }
  ],
  "vars": {
    "NEON_AUTH_BASE_URL": "https://ep-crimson-queen-a7q4vgfn.neonauth.ap-southeast-2.aws.neon.tech/neondb/auth",
    "NEON_AUTH_JWKS_URL": "https://ep-crimson-queen-a7q4vgfn.neonauth.ap-southeast-2.aws.neon.tech/neondb/auth/.well-known/jwks.json",
    "NEON_HYPERDRIVE_CA_ID": "d698b258-d68d-4f71-b814-be9d39248d5e",
    "INSTAGRAM_ENABLED": "false",
    "INSTAGRAM_COMMAND_REPLIES_ENABLED": "false",
    "INSTAGRAM_COMMAND_CHECKINS_ENABLED": "false",
    "INSTAGRAM_COMMAND_PUBLICATION_ENABLED": "false",
    "INSTAGRAM_DM_ENABLED": "false",
    "INSTAGRAM_AUTO_CLAIM_ENABLED": "false",
    "COMMUNITY_POSTS_ENABLED": "false",
    "COMMUNITY_PILOT_BEACHES": "",
    "INSTAGRAM_APP_ID": "1667613151655339",
    "INSTAGRAM_GRAPH_VERSION": "v26.0",
    "INSTAGRAM_DISCOVERY_ENABLED": "false",
    "INSTAGRAM_PUBLICATION_ENABLED": "false",
    "INSTAGRAM_HASHTAGS_ENABLED": "false",
    "INSTAGRAM_ACCOUNT_ID": "17841461601419539",
    "INSTAGRAM_MESSAGING_GRAPH_VERSION": "v26.0",
    "INSTAGRAM_MESSAGING_REDIRECT_URI": "https://api.finfolk.com.au/v1/integrations/instagram/oauth/callback",
    "INSTAGRAM_MESSAGING_PROVIDER": "instagram-facebook",
    "INSTAGRAM_MESSAGING_PAGE_ID": "1387107281155901",
    "INSTAGRAM_MESSAGING_META_APP_ID": "1667613151655339",
    "INSTAGRAM_MESSAGING_LOGIN_CONFIG_ID": "2606242293176301",
    "INSTAGRAM_MESSAGING_ACCOUNT_ID": "17841461601419539"
  },
  "routes": [],
  "queues": {
    "producers": [
      {
        "queue": "finfolk-instagram-actions",
        "binding": "INSTAGRAM_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "finfolk-instagram-actions",
        "max_batch_size": 10,
        "max_retries": 5,
        "dead_letter_queue": "finfolk-instagram-dead-letter"
      }
    ]
  },
  "triggers": {
    "crons": []
  }
}
